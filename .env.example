# Environment configuration template for School ERP Copilot
NODE_ENV=development
PORT=3000
CORS_ORIGIN=http://localhost:5173
MONGODB_URI=mongodb://localhost:27017/school_erp_copilot
REDIS_URL=redis://localhost:6379

# Auth
JWT_ACCESS_SECRET=change-me-to-a-secure-random-access-secret-32-chars
JWT_ACCESS_TTL=15m
JWT_REFRESH_SECRET=change-me-to-a-secure-random-refresh-secret-32-chars
JWT_REFRESH_TTL_DAYS=7

# Uploads
UPLOAD_DIR=./storage/uploads
MAX_UPLOAD_MB=20

# AI / LLM / Embeddings
LLM_PROVIDER=openai
OPENAI_API_KEY=
LLM_MODEL=gpt-4o-mini
EMBEDDING_MODEL=text-embedding-3-small
EMBEDDING_DIMENSIONS=1536

# RAG Retrieval
RETRIEVAL_TOP_K=6
RETRIEVAL_MIN_SCORE=0.6
